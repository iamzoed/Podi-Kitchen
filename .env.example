VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Delivery-radius check (all three optional — leave any of them unset and
# the whole check is skipped everywhere, checkout is never blocked on it).
# Fill in your kitchen's real coordinates — do NOT guess/reuse an example.
# VITE_DELIVERY_CENTER_LAT=19.0760
# VITE_DELIVERY_CENTER_LNG=72.8777
# VITE_DELIVERY_RADIUS_KM=2
# Set to "true" to refuse checkout outside the radius instead of just
# warning (default: warn only, order can still proceed).
# VITE_DELIVERY_RADIUS_BLOCK=false
